# Copy this file to .env and replace the placeholders.
# Generate a key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_long_random_secret
DATABASE_URL=sqlite:///registration.db
# Add only if the Country State City API integration is used:
CSC_API_KEY=
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000
COOKIE_SECURE=false
LOG_LEVEL=INFO
